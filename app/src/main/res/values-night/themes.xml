<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ascendy" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/night</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.Ascendy.Blocker" parent="Theme.Ascendy">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
