<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Ascendy" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <!-- See values/themes.xml: transparent-only, because bar colors do nothing on 35+ and
             dropping them would hand API 26-34 the platform's opaque default bars. Icon
             contrast is driven at runtime from the palette in AscendyTheme. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Silently ignored on API 26; honored on 27+. -->
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <style name="Theme.Ascendy.Blocker" parent="Theme.Ascendy">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
