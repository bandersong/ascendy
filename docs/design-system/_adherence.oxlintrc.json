{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/forms/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Roboto))/i]",
        "message": "Font not provided by the design system. Available: Roboto."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|tone|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: label, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:sage|petal|mint|lilac|cloud|smoke)$/]",
        "message": "<Badge> tone must be one of 'sage' | 'petal' | 'mint' | 'lilac' | 'cloud' | 'smoke'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:filled|text|outlined)$/]",
        "message": "<Button> variant must be one of 'filled' | 'text' | 'outlined'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mascot'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|locked|size|bob|style|key|ref|className|style|children)$/]",
        "message": "<Mascot> doesn't accept that prop. Declared props: variant, locked, size, bob, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mascot'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:kawaii|tough|neutral)$/]",
        "message": "<Mascot> variant must be one of 'kawaii' | 'tough' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|innerStyle|children|key|ref|className|style|children)$/]",
        "message": "<PageColumn> doesn't accept that prop. Declared props: style, innerStyle, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectableChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<SelectableChip> doesn't accept that prop. Declared props: label, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SoftCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|onClick|style|children|key|ref|className|style|children)$/]",
        "message": "<SoftCard> doesn't accept that prop. Declared props: tone, onClick, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SoftCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:surface|cloud)$/]",
        "message": "<SoftCard> tone must be one of 'surface' | 'cloud'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|placeholder|type|surface|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, value, onChange, placeholder, type, surface, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeScope'] > JSXAttribute > JSXIdentifier[name!=/^(?:theme|dark|padded|style|children|key|ref|className|style|children)$/]",
        "message": "<ThemeScope> doesn't accept that prop. Declared props: theme, dark, padded, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeScope'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:kawaii|tough|neutral)$/]",
        "message": "<ThemeScope> theme must be one of 'kawaii' | 'tough' | 'neutral'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
